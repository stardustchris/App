## This file contains local configuration for EnduranceFlow
## Copy this file to 'local.properties' and fill in your API keys

# Android SDK location (auto-generated by Android Studio)
sdk.dir=/path/to/Android/sdk

# Gemini AI API Key
# Get your free API key at: https://makersuite.google.com/app/apikey
# IMPORTANT: Keep this key secret! Never commit local.properties to git
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Example (replace with your actual key):
# GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
